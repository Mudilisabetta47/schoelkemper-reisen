# Öffentliche Adresse der neuen Website (Canonical, Sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.scholkemper-reisen.de

# reise-CMS: Adresse, unter der das bestehende CMS nach dem Relaunch erreichbar bleibt
# (Reisedaten, Bilder, Buchung /reise/buchen.php, Newsletter). Siehe docs/REISE-CMS.md
REISECMS_BASE_URL=https://buchung.scholkemper-reisen.de
# optional, falls die Newsletter-Anmeldung unter anderer Adresse liegt
# REISECMS_NEWSLETTER_URL=https://buchung.scholkemper-reisen.de/newsletter/index.php
# "snapshot" = nur src/data/reisen.snapshot.json verwenden (z. B. Tests ohne Netz)
# REISECMS_MODE=snapshot

# Sofort-Aktualisierung der Reisen: POST /api/revalidate mit Header x-revalidate-secret
REVALIDATE_SECRET=

# Formularversand (Brevo Transactional API)
BREVO_API_KEY=
MAIL_TO=info@scholkemper-reisen.de
MAIL_FROM=website@scholkemper-reisen.de

# Nach rechtlicher Prüfung auf "done" setzen – blendet den Prüfhinweis in Rechtstexten aus
NEXT_PUBLIC_LEGAL_REVIEW=
