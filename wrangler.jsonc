{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Name muss dem Worker im Cloudflare-Dashboard entsprechen
  "name": "schoelkemper-reisen",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Bildoptimierung (next/image) über Cloudflare Images
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
